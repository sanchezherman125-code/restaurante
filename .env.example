# Backend FastAPI
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (Supabase en producción, Docker en desarrollo)
DATABASE_URL=postgresql+psycopg://restaurante:restaurante@localhost:5432/restaurante
DATABASE_URL_TEST=postgresql+psycopg://restaurante:restaurante@localhost:5433/restaurante_test
# Sólo E2E: se rechaza cualquier URL cuyo nombre no contenga test/e2e.
TEST_DATABASE_URL=postgresql+psycopg://restaurante:restaurante@localhost:5433/restaurante_e2e_test
DATABASE_ENV=development

# Seguridad
JWT_SECRET=cambie-este-secreto-en-produccion
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase Storage (comprobantes)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# Frontend
FRONTEND_URL=http://localhost:5173

# Limitación de intentos de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
