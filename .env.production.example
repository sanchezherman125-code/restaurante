ENVIRONMENT=production
DATABASE_ENV=production
# Connection string from Supabase, with TLS. Use direct or session-pooler connection.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
JWT_SECRET=
CORS_ORIGINS=https://YOUR-FRONTEND.onrender.com
FRONTEND_URL=https://YOUR-FRONTEND.onrender.com
ALLOWED_HOSTS=YOUR-API.onrender.com
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
BUSINESS_TIMEZONE=America/Lima
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
# Only used when no administrator exists. Remove ADMIN_PIN after first deploy.
ADMIN_USERNAME=
ADMIN_PIN=
